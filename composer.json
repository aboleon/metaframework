{
  "name": "aboleon/metaframework",
  "description": "Meta Framework CMS",
  "minimum-stability": "stable",
  "license": "proprietary",
  "keywords": ["meta framework"],
  "authors": [
    {
      "name": "Aboleon Media",
      "email": "dev@aboleon.media"
    }
  ],
  "require": {
    "php": "^8.3",
    "css-crush/css-crush": "^4.1",
    "intervention/image": "^3.11",
    "symfony/mime": "^7.2",
    "aboleon/metaframework-support": "^0.1",
    "aboleon/metaframework-mediaclass": "^0.1",
    "aboleon/metaframework-inputable": "^0.1"
  },
  "require-dev": {
    "orchestra/testbench": "^9.9",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0.1"
  },
  "autoload": {
    "psr-4": {
      "MetaFramework\\": "src/"
    },
    "files": [
      "src/Functions/loader.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MetaFramework\\ServiceProvider"
      ],
      "aliases": {
        "Meta": "MetaFramework\\Facades\\MetaFacade",
        "Nav": "MetaFramework\\Facades\\NavFacade"
      }
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "path",
      "url": "../metaframework-support"
    },
    {
      "type": "path",
      "url": "../metaframework-mediaclass"
    },
    {
      "type": "path",
      "url": "../metaframework-inputable"
    }
  ]
}
