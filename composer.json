{
  "name": "aboleon/metaframework",
  "description": "Meta Framework CMS",
  "license": "proprietary",
  "keywords": [
    "meta framework"
  ],
  "authors": [
    {
      "name": "Aboleon Media",
      "email": "dev@aboleon.media"
    }
  ],
  "require": {
    "php": "^8.3",
    "css-crush/css-crush": "^v5.0.0",
    "intervention/image": "^3.11",
    "symfony/mime": "^7.2",
    "aboleon/metaframework-support": "0.*",
    "aboleon/metaframework-mediaclass": "0.*",
    "aboleon/metaframework-inputable": "0.*"
  },
  "require-dev": {
    "orchestra/testbench": "^10.6",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0.1"
  },
  "autoload": {
    "psr-4": {
      "MetaFramework\\": "src/"
    },
    "files": [
      "src/Functions/loader.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MetaFramework\\ServiceProvider"
      ],
      "aliases": {
        "Meta": "MetaFramework\\Facades\\MetaFacade",
        "Nav": "MetaFramework\\Facades\\NavFacade"
      }
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
