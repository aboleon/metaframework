{
  "name": "aboleon/metaframework",
  "description": "Meta Framework CMS",
  "license": "proprietary",
  "keywords": [
    "meta framework"
  ],
  "authors": [
    {
      "name": "Aboleon Media",
      "email": "dev@aboleon.media"
    }
  ],
  "require": {
    "php": "^8.3",
    "css-crush/css-crush": "^v5.0.0",
    "symfony/mime": "^7.2",
    "spatie/laravel-translatable": "^6.12",
    "aboleon/metaframework-support": "^1.0",
    "aboleon/metaframework-inputable": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.6|^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0.1|^12.0"
  },
  "autoload": {
    "psr-4": {
      "MetaFramework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MetaFramework\\ServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
